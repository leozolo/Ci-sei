# Copia questo file in .env.local (sviluppo) oppure inserisci le stesse
# variabili su Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La chiave pubblica: "publishable" (sb_publishable_…) oppure la vecchia "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La chiave segreta: "secret" (sb_secret_…) oppure la vecchia "service_role".
# Serve solo per le notifiche push sul telefono. Non condividerla con nessuno.
SUPABASE_SECRET_KEY=

# Facoltative
# true dopo aver configurato Google in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH=false
# Nome dell'app mostrato ovunque (predefinito: Ci sei?)
NEXT_PUBLIC_APP_NAME=Ci sei?
